  'swatplus-modflow',
  model_sources,
  include_directories: include_directories('MODFLOW'),
  fortran_args: [
    '-ffixed-line-length-none',
    '-ffree-line-length-none',
    '-fallow-argument-mismatch',
  ],
  install: true,
)
