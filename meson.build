project(
  'swatplus-modflow',
  'fortran',
  meson_version: '>= 1.0.0',
  default_options: ['buildtype=debug', 'fortran_std=legacy'],
)

fc = meson.get_compiler('fortran')
if fc.get_id() != 'gcc'
  error('This build currently supports GNU Fortran only')
endif

